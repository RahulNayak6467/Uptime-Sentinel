# Docker Compose environment variables (repo root)
# Compose auto-loads a sibling `.env` for ${VAR} substitution in docker-compose.yml.
# Copy this file to `.env` and fill in real values. `.env` is gitignored; this file is committed as documentation.

# --- Postgres (used by the `postgres` service) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
